            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "### When would you like to start your trip?\n\nTo help reserve your hotel and activities, please share your planned start date.\n\nPlease reply with your start date (e.g., `2026-08-20`)."
