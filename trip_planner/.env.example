# Copy this file to .env and fill in your Gemini API key from Google AI Studio.
# Get a key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Local model overrides (3.5 models are supported on internal corp endpoints)
FLASH_MODEL=gemini-3.5-flash-lite
PRO_MODEL=gemini-3.5-flash

